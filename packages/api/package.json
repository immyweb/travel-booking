{
  "name": "@travel-booking/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=.env --watch src/index.ts",
    "start": "bun --env-file=../../.env --env-file=.env src/index.ts",
    "test": "bun --bun --env-file=../../.env --env-file=.env.test vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@travel-booking/core": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^6.9.1",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
