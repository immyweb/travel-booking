{
  "name": "travel-booking",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --parallel --if-present --filter='*' dev",
    "dev:api": "bun run --filter='@travel-booking/api' dev",
    "dev:web": "bun run --filter='@travel-booking/web' dev",
    "build:web": "bun run --filter='@travel-booking/web' build",
    "start:web": "bun run --filter='@travel-booking/web' start",
    "start:api": "bun run --filter='@travel-booking/api' start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --parallel --if-present --filter='*' test",
    "test:api": "bun run --filter='@travel-booking/api' test",
    "test:web": "bun run --filter='@travel-booking/web' test",
    "test:e2e": "bun run --filter='@travel-booking/e2e' test",
    "typecheck": "bun run --filter='*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
